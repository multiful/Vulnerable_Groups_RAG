# File: .env.example
# Last Updated: 2026-05-12
# Role: 환경변수 템플릿 — 실제 값은 backend/.env (gitignored)에 작성
#
# 사용 방법
# 1) 이 파일을 backend/.env 로 복사
# 2) 본인 환경에 맞게 값 채우기 (특히 *_KEY 들)
# 3) .env 는 절대 git 에 커밋하지 말 것 (.gitignore 에서 제외 처리됨)

# ============================================================
# Supabase (pgvector)
# ============================================================
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# service_role secret: Supabase Dashboard → Project Settings → API → service_role
# ⚠️ 절대 공개 X — placeholder 그대로 두고 본인 .env 에서만 실제 값 사용
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
# pgvector 임베딩 저장 테이블 이름 (테이블 미생성 시 디폴트 유지)
SUPABASE_TABLE_NAME=documents

# pgvector 유사도 검색용 RPC 함수 이름 (함수 미생성 시 디폴트 유지)
SUPABASE_MATCH_RPC=match_documents

# ============================================================
# 임베딩 provider
# ============================================================
# openai | huggingface
EMBEDDING_PROVIDER=openai

# ============================================================
# OpenAI (EMBEDDING_PROVIDER=openai 일 때 필수)
# ============================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# HuggingFace (EMBEDDING_PROVIDER=huggingface 일 때 사용)
# ============================================================
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# HTTP / CORS
# ============================================================
# 쉼표로 구분. 프론트(Vite) 로컬 + 배포 도메인
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://didim.life,https://www.didim.life

# ============================================================
# RAG
# ============================================================
RAG_TOP_K=5
CHUNKS_JSONL_RELATIVE=data/index_ready/chunks/chunks.jsonl

# ============================================================
# 한국산업인력공단 (Q-Net / HRD Korea) — 시험 일정·자격정보
# ============================================================
HRDKOREA_API_KEY_IN=your-hrdkorea-api-key-url-encoded
HRDKOREA_API_KEY_DE=your-hrdkorea-api-key-decoded

# ============================================================
# 워크넷 채용정보 (고용노동부)
# ============================================================
GET_JOB_API_KEY=your-worknet-job-api-key

# ============================================================
# 국민내일배움카드 훈련과정 (Work24)
# ============================================================
GET_TRAINING_API_KEY=your-work24-training-api-key

# ============================================================
# 서울시 공공데이터 API
# ============================================================
SEOUL_API_KEY=your-seoul-api-key
SEOUL_API_KEY2=your-seoul-api-key2
SEOUL_API_KEY3=your-seoul-api-key3

# ============================================================
# 커리어넷
# ============================================================
CAREER_NET_API_KEY=your-careernet-api-key

# ============================================================
# 카카오 REST API
# ============================================================
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# ============================================================
# YouTube Data API v3
# ============================================================
YOUTUBE_API_KEY=your-youtube-api-key

# ============================================================
# 한국사회보장정보원 (복지로 OPEN API)
# 중앙부처복지서비스 + 지자체복지서비스 공용 키
# 발급: https://www.bokjiro.go.kr/ssis-tbu/s1/openApiCheck.do
# ============================================================
BOKJIRO_API_KEY=your-bokjiro-api-key

# ============================================================
# 성평등가족부 OPEN API
# 건강가정지원센터 + 여성·가족·청소년·권익시설정보 공용 키
# 발급: https://www.data.go.kr (제공기관: 성평등가족부)
# ============================================================
GENDER_WELFARE_API_KEY=your-gender-welfare-api-key

# ============================================================
# 워크넷 정부지원일자리 참여자모집 API
# GET_JOB_API_KEY와 동일 키 공유 가능
# 발급: https://www.work24.go.kr/cm/openApi/
# ============================================================
WORKNET_GOVT_JOBS_API_KEY=your-worknet-govt-jobs-api-key

# ============================================================
# 온통청년 OPEN API (youthcenter.go.kr)
# 청년정책(getPlcy) + 청년공간(getSpace) + 청년콘텐츠(getContent) 공용 키
# 발급: https://www.youthcenter.go.kr/go/ythip
# ============================================================
YOUTH_CENTER_API_KEY=your-youth-center-api-key

# ============================================================
# Work24 확장 훈련과정 API (HRD-Korea, 한국산업인력공단)
# 발급: https://www.work24.go.kr/cm/openApi/
# ============================================================
# 일학습병행 훈련과정 (callOpenApiSvcInfo313L01)
GET_WORKSTUDY_API_KEY=your-workstudy-api-key
# 구직자취업역량 강화프로그램 (엔드포인트 승인 대기 중)
GET_PROGRAM_API_KEY=your-program-api-key
# 국가인적자원개발 컨소시엄 훈련과정 (callOpenApiSvcInfo312L01)
GET_HUMANDE_API_KEY=your-humande-api-key
